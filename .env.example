# Copie para .env e ajuste. Todas as variáveis usam o prefixo IPEIA_.

# Banco: SQLite para desenvolvimento, PostgreSQL em produção.
IPEIA_DATABASE_URL=sqlite:///./ipeia.db
# IPEIA_DATABASE_URL=postgresql+psycopg://ipeia:ipeia@localhost:5432/ipeia

# Motor de linguagem: "mock" (regras locais, sem GPU) ou "openai" (qualquer
# servidor compatível com a API da OpenAI: llama-server no servidor próprio, vLLM no
# Modal ou Hetzner, Featherless).
IPEIA_LLM_BACKEND=mock
IPEIA_LLM_BASE_URL=http://localhost:8000/v1
IPEIA_LLM_API_KEY=
IPEIA_LLM_MODELO=amadeusai/Amadeus-Verbo-MI-Qwen-2.5-7B-PT-BR-Instruct-Experimental
# Janela usada para conferir o tamanho dos blocos do acervo (cada bloco <= metade).
# Deve ser igual ao --ctx-size do servidor de inferência.
IPEIA_CAG_JANELA_TOKENS=32768

# Transcrição: "mock", "faster_whisper" (local) ou "openai" (endpoint /audio/transcriptions).
IPEIA_STT_BACKEND=mock
IPEIA_STT_BASE_URL=http://localhost:8001/v1
IPEIA_STT_API_KEY=
IPEIA_STT_MODELO=large-v3-turbo
# faster-whisper local: auto, cuda ou cpu; e int8 (CPU), int8_float16 (GPU) ou default.
IPEIA_STT_DISPOSITIVO=auto
IPEIA_STT_TIPO_COMPUTACAO=default

# WhatsApp: "mock" (guarda as mensagens em memória) ou "cloud" (WhatsApp Cloud API).
IPEIA_WHATSAPP_BACKEND=mock
IPEIA_WHATSAPP_TOKEN=
IPEIA_WHATSAPP_PHONE_NUMBER_ID=
IPEIA_WHATSAPP_APP_SECRET=
IPEIA_WHATSAPP_VERIFY_TOKEN=troque-este-token

# ---------------------------------------------------------------------------
# Servidor próprio com RTX 3050 6 GB (ver docs/servidor-proprio.md).
# Perfil A, recomendado para o piloto: Amadeus-Verbo 3B + Whisper, tudo na GPU.
#   IPEIA_LLM_BACKEND=openai
#   IPEIA_LLM_BASE_URL=http://127.0.0.1:8000/v1
#   IPEIA_LLM_MODELO=amadeusai/Amadeus-Verbo-MI-Qwen-2.5-3B-PT-BR-Instruct-Experimental
#   IPEIA_CAG_JANELA_TOKENS=32768
#   IPEIA_STT_BACKEND=faster_whisper
#   IPEIA_STT_DISPOSITIVO=cuda
#   IPEIA_STT_TIPO_COMPUTACAO=int8_float16
# Perfil B, para comparar: Amadeus-Verbo 7B na GPU, Whisper na CPU, janela menor.
#   IPEIA_LLM_MODELO=amadeusai/Amadeus-Verbo-MI-Qwen-2.5-7B-PT-BR-Instruct-Experimental
#   IPEIA_CAG_JANELA_TOKENS=8192
#   IPEIA_STT_DISPOSITIVO=cpu
#   IPEIA_STT_TIPO_COMPUTACAO=int8

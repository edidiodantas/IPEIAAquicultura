# Unidade systemd do llama-server (llama.cpp) servindo o Amadeus-Verbo na RTX 3050 6 GB.
# Instalar:  sudo cp deploy/llama-server.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now llama-server
#
# Perfil A (padrão abaixo): 3B Q6_K, janela de 32k, sobra GPU para o Whisper.
# Perfil B: troque MODELO para o 7B Q4_K_M e CTX para 8192, e ponha o Whisper na CPU
#           (IPEIA_STT_DISPOSITIVO=cpu). IPEIA_CAG_JANELA_TOKENS deve ser igual a CTX.
[Unit]
Description=llama-server Amadeus-Verbo (IPEIA)
After=network-online.target

[Service]
Environment=MODELO=/srv/ipeia/modelos/amadeus-verbo-mi-3b-Q6_K.gguf
Environment=CTX=32768
# Só escuta localmente: o WhatsApp nunca fala direto com o modelo.
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model ${MODELO} --alias amadeus-verbo \
  --host 127.0.0.1 --port 8000 \
  --n-gpu-layers 999 --ctx-size ${CTX} --parallel 1 \
  --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0 \
  --cache-ram 4096 --seed 42
Restart=on-failure
User=ipeia

[Install]
WantedBy=multi-user.target
